# odoo-griffity-prod stack: copy to .env on the VPS (chmod 600) and replace every "changeme".
# ODOO_DB_NAME/USER/PASSWORD must match backup/.env (checked by ../setup.sh).
ODOO_IMAGE_TAG=026aae4
ODOO_DB_NAME=tomagency.griffity.de
ODOO_DB_USER=changeme
ODOO_DB_PASSWORD=changeme
ODOO_CONFIG_ENCRYPTION_KEY=changeme
# host directory with odoo.conf (secrets in odoo.conf stay on the VPS)
ODOO_CONF_DIR=/opt/odoo/conf

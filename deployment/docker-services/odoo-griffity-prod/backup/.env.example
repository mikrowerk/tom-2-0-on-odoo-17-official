# backup of odoo-griffity-prod: copy to .env on the VPS (chmod 600) and replace every "changeme".
# ODOO_DB_NAME/USER/PASSWORD must match ../.env (checked by ../../setup.sh).
ODOO_DB_NAME=tomagency.griffity.de
ODOO_DB_USER=changeme
ODOO_DB_PASSWORD=changeme
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_REGION=eu-central-1
S3_BUCKET=changeme
ENCRYPTION_PASSWORD=changeme
BACKUP_RETENTION=10d
